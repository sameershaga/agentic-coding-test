#!/usr/bin/env bash
set -euo pipefail

SESSION="${1:?tmux session required}"
WORKTREE="${2:?worktree required}"
TIMEOUT_SECONDS="${3:-43200}"
POLL_SECONDS=2

started="$(date +%s)"
seen_log=""

while tmux has-session -t "$SESSION" 2>/dev/null; do
  now="$(date +%s)"

  if [ $((now - started)) -ge "$TIMEOUT_SECONDS" ]; then
    echo "[gnhf-auto-exit] timeout reached; sending Ctrl+C" >&2
    tmux send-keys -t "$SESSION" C-c
    exit 0
  fi

  latest_log="$(
    find "$WORKTREE/.gnhf/runs" \
      -type f \
      -name 'gnhf.log' \
      -printf '%T@ %p\n' 2>/dev/null |
    sort -nr |
    head -1 |
    cut -d' ' -f2-
  )"

  if [ -n "$latest_log" ]; then
    if [ "$latest_log" != "$seen_log" ]; then
      echo "[gnhf-auto-exit] watching $latest_log" >&2
      seen_log="$latest_log"
    fi

    if grep -q '"event":"orchestrator:end"' "$latest_log"; then
      echo "[gnhf-auto-exit] detected orchestrator:end; sending Ctrl+C" >&2
      tmux send-keys -t "$SESSION" C-c
      exit 0
    fi
  fi

  sleep "$POLL_SECONDS"
done
