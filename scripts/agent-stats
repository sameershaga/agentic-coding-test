#!/usr/bin/env python3
"""Print aggregate agent run telemetry for this repository."""

from pathlib import Path

from agent_telemetry import aggregate_records, read_records, render_report


def main() -> None:
    repo_root = Path(__file__).resolve().parent.parent
    records, malformed = read_records(repo_root)
    print(render_report(aggregate_records(records), malformed), end="")


if __name__ == "__main__":
    main()
