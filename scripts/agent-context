#!/usr/bin/env python3
"""Build a compact project-context packet for one agent task."""

import argparse
import json
import sys
from pathlib import Path

from agent_context import build_context
from agent_memory import MemoryError, MemoryStore, shared_repository_root


def main() -> int:
    parser = argparse.ArgumentParser(prog="agent-context")
    parser.add_argument("--task", required=True)
    parser.add_argument("--budget", required=True, type=int)
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    parser.add_argument("--root", type=Path, help=argparse.SUPPRESS)
    args = parser.parse_args()
    try:
        result = build_context(
            MemoryStore(args.root or shared_repository_root()), args.task, args.budget
        )
    except (MemoryError, ValueError, OSError) as error:
        print(f"agent-context: {error}", file=sys.stderr)
        return 1
    print(json.dumps(result, sort_keys=True) if args.json else result["packet"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
