# gnhf orchestration state is local to each run.
.gnhf/

# Captain task records, locks, logs, sockets, and handoffs are runtime state.
.captain/runtime/

# Treehouse worktrees and lease metadata must never enter the integration tree.
.treehouse/

# Agent run telemetry is local runtime state.
.agent-runs/

# Captain runtime state
.captain/runtime/

# Python runtime artifacts
__pycache__/
*.py[cod]

# Local shared agent memory
.agent-memory/

# Durable daily task inbox is local runtime state.
.agent-tasks/

# Daily planner plans, signals, locks, and history are local runtime state.
.agent-planner/
